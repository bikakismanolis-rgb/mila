# Αντίγραψέ το σε apps/web/.env.local και συμπλήρωσε τις τιμές.
# Ό,τι αρχίζει με VITE_ μπαίνει στο bundle και το βλέπει ο κόσμος —
# μη βάλεις ποτέ secret εδώ. Το anon key είναι σχεδιασμένο να είναι δημόσιο.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google Sign-In (Google Cloud Console → Credentials → OAuth client ID, τύπου Web).
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Το δημόσιο domain του app. Το χρειάζονται τα native builds (Android/iOS/desktop):
# εκεί το window.location.origin είναι capacitor://localhost, που δεν κάνει για
# redirect μετά από επιβεβαίωση email. Πρέπει να είναι καταχωρημένο στη Supabase
# (Authentication → URL Configuration → Redirect URLs).
VITE_PUBLIC_SITE_URL=https://mila-web-ivory.vercel.app
