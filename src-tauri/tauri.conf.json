{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mila",
  "version": "0.1.0",
  "identifier": "com.milamessenger.app",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @email-messenger/web",
    "beforeBuildCommand": "npm run build -w @email-messenger/web"
  },
  "app": {
    "windows": [
      {
        "title": "Mila",
        "width": 1180,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Messenger με email αντί για τηλέφωνο",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
